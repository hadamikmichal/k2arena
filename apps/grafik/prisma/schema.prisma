generator client {
  provider = "prisma-client-js"
}

// Postgres: na Vercelu baza Neon (integracja Marketplace ustawia obie zmienne).
// DATABASE_URL – połączenie przez pooler, DATABASE_URL_UNPOOLED – bezpośrednie (migracje).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Role: ADMIN (układa grafik) | INSTRUCTOR (podgląd własnego grafiku)
// Zatrudnienie: STALY (pn–pt) | ZLECENIE (zleceniobiorcy / studenci, sb–nd)
//              | UOP (jak stały, z miesięczną normą godzin) | TYLKO_SEKCJE (bez dyżurów)
model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  role                    String                   @default("INSTRUCTOR")
  employment              String                   @default("STALY")
  color                   String                   @default("#2563eb")
  active                  Boolean                  @default(true)
  icalToken               String                   @unique @default(cuid())
  createdAt               DateTime                 @default(now())
  // Powiadomienia nowsze niż ta data są dla użytkownika nieprzeczytane (dzwonek w nagłówku).
  notificationsSeenAt     DateTime                 @default(now())
  pushSubscriptions       PushSubscription[]
  shifts                  Shift[]
  sectionSeries           SectionSeries[]
  sectionSessions         SectionSession[]
  availability            Availability[]
  availabilitySubmissions AvailabilitySubmission[]
  reviewedForms           ClientForm[]
}

// Zmiana w grafiku. Typ: OPERATOR (dyżur operatora ściany) | ROUTESETTING
// Data jako "YYYY-MM-DD", godziny jako minuty od północy (czas lokalny Europe/Warsaw).
model Shift {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String
  startMin      Int
  endMin        Int
  type          String   @default("OPERATOR")
  note          String?
  googleEventId String?
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([userId, date])
}

// Cykliczna sekcja (np. "Dzieci 7–10 lat", wtorki 16:30–18:00)
model SectionSeries {
  id        String           @id @default(cuid())
  name      String
  kind      String           @default("DZIECI") // DZIECI | DOROSLI
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  weekday   Int // 1 = poniedziałek ... 7 = niedziela
  startMin  Int
  endMin    Int
  validFrom String
  validTo   String
  active    Boolean          @default(true)
  sessions  SectionSession[]
}

// Pojedyncze zajęcia sekcji (wygenerowane z serii albo jednorazowe).
// Status: PLANNED | DONE | CANCELLED
model SectionSession {
  id            String         @id @default(cuid())
  seriesId      String?
  series        SectionSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name          String
  kind          String         @default("DZIECI")
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  date          String
  startMin      Int
  endMin        Int
  status        String         @default("PLANNED")
  note          String?
  googleEventId String?
  updatedAt     DateTime       @updatedAt

  @@index([date])
  @@index([userId, date])
}

// Ustawienia reguł grafiku (JSON) – klucz "rules"
model Setting {
  key   String @id
  value String
}

// Dyspozycyjność: przedziały, w których instruktor może pracować danego dnia.
// Brak wiersza dla dnia przy złożonym zgłoszeniu = niedostępny.
model Availability {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String
  startMin Int
  endMin   Int

  @@index([date])
  @@index([userId, date])
}

// Zgłoszenie dyspozycyjności na miesiąc ("YYYY-MM") – odróżnia "nie zgłosił" od "niedostępny".
model AvailabilitySubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String
  note        String?
  submittedAt DateTime @default(now())

  @@unique([userId, month])
}

// Ankieta klienta ściany (formularz danych osobowych), wypełniana publicznie przez kod QR.
// Status: WERYFIKACJA (wszystkie odpowiedzi TAK – instruktor sprawdza umiejętności)
//       | SZKOLENIE (choć jedno NIE – klient idzie na wprowadzenie START / szkolenie)
//       | ZAKONCZONE (instruktor potwierdził umiejętności i nadał kategorię)
// Kategorie (category, po przecinku): A – autoasekuracja, W – wędka, P – prowadzenie.
model ClientForm {
  id             String    @id @default(cuid())
  name           String
  birthDate      String
  phone          String
  email          String
  minor1         String?
  minor2         String?
  knowsAutobelay Boolean
  canHarness     Boolean
  canBelay       Boolean
  status         String
  category       String?
  note           String?
  reviewedById   String?
  reviewedBy     User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  // Dowód złożenia oświadczeń: wersja treści (CONSENTS w src/lib/clientForm.ts), adres IP i przeglądarka.
  consentVersion String    @default("2026-11-06")
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
}

// Powiadomienie w aplikacji (dzwonek w nagłówku) – wspólne dla wszystkich zalogowanych.
// Rodzaj: ANKIETA (nowa ankieta klienta). Stan „przeczytane” – User.notificationsSeenAt.
model Notification {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String
  href      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Subskrypcja Web Push jednego urządzenia (telefon z aplikacją na ekranie początkowym, przeglądarka).
// Powiadomienia przychodzą też przy zablokowanym ekranie. Wygasłe subskrypcje są usuwane przy wysyłce.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
