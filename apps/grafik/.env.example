# Baza danych – lokalnie Postgres z docker-compose.yml; na Vercelu ustawiane przez integrację Neon
DATABASE_URL="postgresql://k2:k2@localhost:5433/grafik"
DATABASE_URL_UNPOOLED="postgresql://k2:k2@localhost:5433/grafik"

# Sekret do podpisywania sesji – wygeneruj: openssl rand -base64 32
AUTH_SECRET="zmien-mnie-na-losowy-ciag-min-32-znaki"

# Publiczny adres aplikacji (używany w linkach iCal)
APP_URL="http://localhost:3010"

# --- Google Calendar API (opcjonalnie) ---
# Lokalnie: ścieżka do pliku JSON konta serwisowego
# GOOGLE_SERVICE_ACCOUNT_FILE="./google-service-account.json"
# Na Vercelu (brak plików): cała zawartość JSON w jednej zmiennej
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_CALENDAR_ID="xxxxxxxx@group.calendar.google.com"

# --- Ankieta klienta: powiadomienia WhatsApp przez Green-API (opcjonalnie, patrz README) ---
# GREEN_API_URL="https://7105.api.greenapi.com"   # apiUrl z panelu Green-API
# GREEN_API_INSTANCE_ID="7105123456"
# GREEN_API_TOKEN="..."
# WHATSAPP_GROUP_ID="120363000000000000@g.us"     # z: npm run whatsapp:groups
